# Copy to .env.local and fill in. .env.local is gitignored; this file is
# documentation and must only ever contain placeholders.

# ── Database ────────────────────────────────────────────────────────────────
# Local development: `npm run db:local` serves Postgres (PGlite) on 54329.
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:54329/postgres"
#
# Production (Supabase → Project Settings → Database → Connection string):
# the TRANSACTION pooler (port 6543) for the running app, and the SESSION
# pooler (port 5432) as DIRECT_URL for migrations — DDL cannot run through the
# transaction pooler.
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Staff sign-in (Supabase Auth) ───────────────────────────────────────────
# Until these are set, /admin shows "sign-in is not set up yet" and the public
# site works normally.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses row-level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Photos ──────────────────────────────────────────────────────────────────
# Who resizes vehicle photos for each screen (lib/media.ts). Unset (today):
# Cloudinary does, at a Cloudinary credit per thousand new sizes, which the
# free plan cannot absorb with a full catalogue. "vercel": Cloudinary makes
# one copy of each photo and Vercel resizes and caches it for 31 days
# (../docs/LAUNCH.md, A.9). Read at build time: redeploy after changing it.
# WARNING: set it only on Vercel Pro. On Hobby, Vercel stops resizing new
# photos after 5,000 a month and shows their description text instead.
# NEXT_PUBLIC_IMAGE_DELIVERY="vercel"

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Without these, nothing is emailed and nothing is queued (lib/email.ts).
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="info@sabicars.com"
# RESEND_FROM_NAME="Sabicars"
# For tests only: scripts/verify-outbox.mts points this at a stand-in for
# Resend. Never set it here or in Vercel, or real email goes nowhere.
# RESEND_API_URL=""

# ── Partner payouts (Paystack) ──────────────────────────────────────────────
# Set in Vercel only — never in a local .env. The live secret key pays partners
# from Sabicars' Paystack balance and checks whose name a bank account is in.
# Without it, payouts are recorded as bank transfers made outside the platform,
# and a manager confirms each account by hand.
# PAYSTACK_SECRET_KEY=""

# ── Legacy import (scripts/import-legacy.mts) ───────────────────────────────
# The legacy Express API's MONGO_URI. Read-only use; needed until cutover.
LEGACY_MONGO_URI=""

# ── Walkthroughs (Playwright; ../docs/LAUNCH.md, A.10) ──────────────────────
# None of these is needed to run the site. GitHub Actions sets them itself;
# set them here only to run a suite by hand.
# The address `npm run test:smoke` walks, read-only (default http://localhost:3000).
# SMOKE_BASE_URL="http://localhost:3000"
# The address `npm run test:e2e` drives. Its rows go into DATABASE_URL above, so never the live database.
# E2E_BASE_URL="http://localhost:3000"
# A staff sign-in made for the tests alone (npm run staff:create against a scratch database); without both, the staff tests are skipped.
# E2E_STAFF_EMAIL=""
# E2E_STAFF_PASSWORD=""
